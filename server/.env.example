# Port the ChatScan API listens on.
PORT=4000

# Origin allowed to call the API (the ChatScan client dev server by default).
CHATSCAN_CORS_ORIGIN=http://localhost:5173

# Where the local ledger index is persisted. Only hashes, ids and status are
# ever written here - never message content.
CHATSCAN_DATA_FILE=./data/ledger.json
